# ─────────────────────────────────────────────────────────
# GARDENPULSE: ENVIRONMENT VARIABLES TEMPLATE
# ─────────────────────────────────────────────────────────
# Note: In Expo SDK 49+, variables accessed in client code 
# MUST be prefixed with EXPO_PUBLIC_
# ─────────────────────────────────────────────────────────

# APP ENVIRONMENT
EXPO_PUBLIC_APP_ENV=development # Options: development, staging, production

# ─────────────────────────────────────────────────────────
# 1. FIREBASE (Backend, Auth, Firestore, Storage)
# ─────────────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─────────────────────────────────────────────────────────
# 2. GOOGLE AI STUDIO (Gemini API Layer)
# ─────────────────────────────────────────────────────────
# Used for Leaf Diagnostics, Vision scanning, and Multimodal chat
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────
# 3. GOOGLE MAPS PLATFORM (Location Services)
# ─────────────────────────────────────────────────────────
# Best practice: Create separate API keys for iOS and Android 
# in Google Cloud Console so you can restrict them by package name.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=your_google_maps_android_key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=your_google_maps_ios_key

# ─────────────────────────────────────────────────────────
# 4. OPENWEATHER API (Weather Services)
# ─────────────────────────────────────────────────────────
# Used for the Weather Intelligence Layer and Smart Scheduler
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# ─────────────────────────────────────────────────────────
# 5. GOOGLE ADMOB (Monetization Ad Units)
# ─────────────────────────────────────────────────────────
# Note: The main AdMob App IDs are placed in app.json. 
# Below are the specific Ad Unit IDs for your UI components.
# ALWAYS use Google's official Test IDs during development.

# --- ANDROID AD UNITS ---
EXPO_PUBLIC_ADMOB_NATIVE_ANDROID=ca-app-pub-3940256099942544/2247696110 # Test ID
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=ca-app-pub-3940256099942544/5224354917 # Test ID
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-3940256099942544/1033173712 # Test ID

# --- IOS AD UNITS ---
EXPO_PUBLIC_ADMOB_NATIVE_IOS=ca-app-pub-3940256099942544/3986624511 # Test ID
EXPO_PUBLIC_ADMOB_REWARDED_IOS=ca-app-pub-3940256099942544/1712485313 # Test ID
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=ca-app-pub-3940256099942544/4411468910 # Test ID